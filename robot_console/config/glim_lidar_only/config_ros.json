{
  /*** ROS-related config (LiDAR only, bag playback) ***
  Same as sim_robot/config/glim/config_ros.json except the topics:
    - points_topic /playback/points: the console's bag playback remaps the bag's point cloud topic onto it
    - imu_topic: a topic nothing publishes (sub and global mapping run with enable_imu false)
  Kept from there: glim_ frame prefixes (own TF tree glim_map -> glim_odom -> glim_imu -> glim_lidar), reliable
  points QoS, headless (no standard_viewer), image_topic non-empty (GLIM 1.2.2 aborts on an empty one).
  acc_scale is unused without IMU.
  */
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "imu_frame_id": "glim_imu",
    "lidar_frame_id": "glim_lidar",
    "base_frame_id": "",
    "odom_frame_id": "glim_odom",
    "map_frame_id": "glim_map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-6,
    "extension_modules": [
      "libmemory_monitor.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "/glim_unused_imu",
    "points_topic": "/playback/points",
    "image_topic": "/glim_unused_image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "default",
      "depth": 10
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
