{
  "name": "robot-console-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "build:plugins": "node scripts/build-plugins.mjs",
    "dev:demo": "vite -c vite.demo.config.ts",
    "build:demo": "vue-tsc -b && vite build -c vite.demo.config.ts && vite build --mode console-preview --base ./ --outDir dist-demo/console --emptyOutDir",
    "preview:demo": "vite preview -c vite.demo.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "5.6.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
