+void virtual_imu(MeasureGroup &meas)
+{
+    /** Virtual IMU samples over [lidar_beg_time, lidar_end_time] for the LiDAR-only mode: constant angular
+     ** velocity vimu_gyr, specific force = -R(t)^T * g (no acceleration). The samples are made consistent with the
+     ** current filter state (its gravity and bias estimates), so that after the filter removes the biases and adds
+     ** gravity the net input is exactly (vimu_gyr, zero acceleration): gravity and biases are not observable without
+     ** an IMU and must not turn into a fake acceleration or rotation. **/
+    meas.imu.clear();
+    state_ikfom s = kf.get_x();
+    M3D R0 = s.rot.toRotationMatrix();
+    const bool started = vimu_t_prev >= 0;   // before the first update: IMU initialisation, gravity along -z
+    V3D grav = started ? V3D(s.grav[0], s.grav[1], s.grav[2]) : V3D(0, 0, -G_m_s2);
+    V3D ba = started ? V3D(s.ba) : V3D(Zero3d);
+    V3D gyr = vimu_gyr + (started ? V3D(s.bg) : V3D(Zero3d));
+    double t_ref = started ? vimu_t_prev : meas.lidar_beg_time;
+    double t0 = meas.lidar_beg_time, t1 = meas.lidar_end_time;
+    int n = std::max(2, int(std::ceil((t1 - t0) / VIMU_DT)));
+    for (int k = 0; k <= n; k++)
+    {
+        double t = t0 + (t1 - t0) * k / n;
+        M3D Rt = R0 * Exp(vimu_gyr, t - t_ref);
+        V3D acc = ba - Rt.transpose() * grav;
+        sensor_msgs::msg::Imu::SharedPtr m(new sensor_msgs::msg::Imu());
+        m->header.stamp = get_ros_time(t);
+        m->angular_velocity.x = gyr(0);
+        m->angular_velocity.y = gyr(1);
+        m->angular_velocity.z = gyr(2);
+        m->linear_acceleration.x = acc(0);
+        m->linear_acceleration.y = acc(1);
+        m->linear_acceleration.z = acc(2);
+        meas.imu.push_back(m);
+    }
+    last_timestamp_imu = t1;
+}
