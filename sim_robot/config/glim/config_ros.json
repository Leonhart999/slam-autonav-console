{
  /*** ROS-related config (sim_robot) ***
  Changes from the GLIM defaults:
    - topics: the same inputs as FAST-LIO (cloud_adapter output and the simulated IMU)
    - frame IDs prefixed with glim_: GLIM publishes TF map -> odom -> imu itself. With the default names it would
      give imu_link a second parent (base_link -> imu_link is static in sim.launch.py) and clash with the wheel
      odometry / AMCL odom and map frames. A separate tree glim_map -> glim_odom -> glim_imu -> glim_lidar works
      like FAST-LIO's camera_init -> body.
    - points_qos reliable: large clouds get dropped with best_effort when DDS fragments them (same fix as FAST-LIO)
    - no standard_viewer (OpenGL window); the console runs GLIM headless
    - acc_scale 1.0: Gazebo publishes acceleration in m/s^2
  */
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "imu_frame_id": "glim_imu",
    "lidar_frame_id": "glim_lidar",
    "base_frame_id": "",
    "odom_frame_id": "glim_odom",
    "map_frame_id": "glim_map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-6,
    "extension_modules": [
      "libmemory_monitor.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "/imu",
    "points_topic": "/points_fastlio",
    "image_topic": "/glim_unused_image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "default",
      "depth": 10
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
