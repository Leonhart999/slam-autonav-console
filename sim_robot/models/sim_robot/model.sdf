<?xml version="1.0"?>
<!--
  仿真小车：差速底盘 + 16 线 3D 激光雷达 + IMU
  坐标约定（全部是 ROS 常用的 x 前、y 左、z 上）：
    base_link  车体中心，高度和轮轴一样（离地 0.1 m）；IMU 就装在这里
    lidar_link 在 base_link 前方 0.1 m、上方 0.3 m，不旋转
  所以 FAST-LIO 的外参是 extrinsic_T = [0.1, 0, 0.3]，extrinsic_R = 单位阵。
  真值由 OdometryPublisher 直接从物理引擎读出 base_link 的位姿，和 IMU 是同一个点。
-->
<sdf version="1.8">
  <model name="sim_robot">

    <!-- ===== 车体 ===== -->
    <link name="base_link">
      <inertial>
        <mass>10.0</mass>
        <inertia><ixx>0.152</ixx><iyy>0.227</iyy><izz>0.342</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.5 0.4 0.15</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.5 0.4 0.15</size></box></geometry>
        <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.3 0.6 1</diffuse></material>
      </visual>

      <!-- 前后两个万向球，摩擦设为 0，只起支撑作用 -->
      <collision name="caster_front">
        <pose>0.2 0 -0.05 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_back">
        <pose>-0.2 0 -0.05 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>

      <!-- 雷达支架，只是外观 -->
      <visual name="lidar_post">
        <pose>0.1 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.15</length></cylinder></geometry>
      </visual>

      <!-- IMU：200 Hz，加一点高斯噪声和零偏，接近消费级 IMU -->
      <sensor name="imu" type="imu">
        <topic>/imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.01</bias_mean></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.01</bias_mean></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev><bias_mean>0.01</bias_mean></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ===== 两个驱动轮（圆柱绕 x 轴转 90° 后轴线沿 y） ===== -->
    <link name="left_wheel">
      <pose>0 0.225 0 -1.5708 0 0</pose>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.0027</ixx><iyy>0.0027</iyy><izz>0.005</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.225 0 -1.5708 0 0</pose>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.0027</ixx><iyy>0.0027</iyy><izz>0.005</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <!-- ===== 3D 激光雷达：参数参照 Velodyne VLP-16 ===== -->
    <link name="lidar_link">
      <pose>0.1 0 0.3 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/lidar</topic>                      <!-- 点云发布在 /lidar/points -->
        <ignition_frame_id>lidar_link</ignition_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <ray>
          <scan>
            <!-- 水平 360°，0.2° 一个点；垂直 16 线，-15° 到 +15° -->
            <horizontal><samples>1800</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>16</samples><min_angle>-0.2618</min_angle><max_angle>0.2618</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>100</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>   <!-- 测距噪声 1 cm -->
        </ray>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <!-- ===== 插件 ===== -->
    <!-- 差速驱动：订阅 /cmd_vel，发布轮式里程计 /wheel_odom -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel_odom</odom_topic>
      <tf_topic>/wheel_odom_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- 真值：直接读物理引擎里 base_link 的位姿，100 Hz，三维 -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth</odom_topic>
      <tf_topic>/ground_truth_tf</tf_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
